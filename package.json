{
  "name": "kwikstore-pro",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Universal Indian Billing POS + Multi-Shop + HRMS Desktop Application (SQLite + Multi-Counter)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "license:gen": "node scripts/generate-license.js",
    "electron:build:win": "npm run build && electron-builder --win --x64",
    "electron:build:mac": "npm run build && electron-builder --mac --arm64 --x64 --universal",
    "electron:build:mac:intel": "npm run build && electron-builder --mac --x64",
    "electron:build:mac:arm": "npm run build && electron-builder --mac --arm64",
    "electron:build:mac:universal": "npm run build && electron-builder --mac --universal",
    "electron:build:all": "npm run electron:build:mac && npm run electron:build:win",
    "electron:build": "npm run electron:build:mac"
  },
  "build": {
    "appId": "com.fleetbillpro.kwikstore",
    "productName": "KwikStore Pro",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RJRAJESH14",
        "repo": "KwikStore"
      }
    ],
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "data/kwikstore.db",
      "data/db-location.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "KwikStore Pro"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
